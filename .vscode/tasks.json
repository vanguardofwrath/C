{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: gcc.exe build active file",
      "command": "E:\\Programs\\MSYS64\\ucrt64\\bin\\gcc.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${fileDirname}\\*.c",
        "-o",
        "-lregex",
        "${fileDirname}\\${fileBasenameNoExtension}.exe",
        "-LE:\\Programs\\MSYS64\\ucrt64\\lib",
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}